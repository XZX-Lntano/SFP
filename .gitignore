# ---------------------------------------------------------------------------
# ZCU102 多机聚合项目 — 快照 .gitignore
# 只提交源码；构建产物、运行/构建日志、站点私有信息一律不入库。
# ---------------------------------------------------------------------------

# 本地编译出的可执行文件
多机/bench_random

# 站点私有参数（真实 IP / ssh 用户 / 密码）放这里，永不提交
多机/local.conf

# 本地 agent / VCS 元数据
.agents/
.codex/
.git/

# Python
__pycache__/
*.py[cod]

# ---- 运行 / 构建日志（可能含绝对路径与主机名）----
*.log
*.jou
*.pb
*.wdb
*.str
*.zip
*.tar.gz
*.ltx
*.dtbo

# ---- Vivado / Xilinx 生成物与产物 ----
*.dcp
*.bit
*.bin
*.xsa
*.xpr
*.o
*.a
*.so
*.ko
.Xil/
*.runs/
*.gen/
*.cache/
*.hw/
*.sim/
*.srcs/
*.ip_user_files/
rev/
xsim.dir/

# 本项目中一次性使用的 Vivado 调试/重建脚本
corundum/fpga/mqnic/ZCU102/fpga/fpga/rebuild*.tcl
corundum/fpga/mqnic/ZCU102/fpga/fpga/check_cdc*.tcl
corundum/fpga/mqnic/ZCU102/fpga/fpga/qcells.*
corundum/fpga/mqnic/ZCU102/fpga/fpga/qexc.*
corundum/fpga/mqnic/ZCU102/fpga/fpga/qfilt*.*

# corundum 主机侧工具二进制
corundum/utils/mqnic-config
corundum/utils/mqnic-dump
corundum/utils/mqnic-fw
corundum/utils/mqnic-bmc
corundum/utils/mqnic-xcvr
corundum/utils/perout

.recycle_bin*/
.tmp*/
client[0-3].log

# CPU profiling 原始 capture
*.data
